  IDS_FIELD_HEIGHT      " (height)"
  IDS_YES               "yes"
  IDS_NO                "no"
  /* Marks a unit id no map places. */
  IDS_UNUSED_UNIT       "  (unused)"
  IDS_NOTHING_CHANGED   "Nothing changed yet"
  IDS_UDTA_CHANGED_ONE  "%d field changed on this unit, %d in all"
  IDS_UDTA_CHANGED_MANY "%d fields changed on this unit, %d in all"
  IDS_UNIT_PROPS_NONE   "No unit properties changed"
