  IDS_SETUP_IN_USE      "Found beside PUDForge"

  /* ----------------------------------------------------------- the sheets */
  IDS_TILESET_FOREST    "Forest"
  IDS_TILESET_WINTER    "Winter"
  IDS_TILESET_WASTELAND "Wasteland"
