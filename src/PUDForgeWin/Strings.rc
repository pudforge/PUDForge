/*
 * Every word the user reads.
 *
 * To translate PUDForge: copy this file, translate the text inside the quotes
 * and nothing else, and build with your copy in place of this one. The menus
 * and dialog templates in PUDForge.rc hold the rest of the text and localise
 * the same way.
 *
 * Things that are not prose — window class names, registry paths, file
 * extensions, the "%04X" a tile id is shown in — deliberately do not appear
 * here. They are not text and translating them would break the program.
 *
 * The voice, so a new string sounds like the ones around it:
 *
 *   Menu items, buttons, tabs and window captions are Title Case. Labels,
 *   hints and prose are sentence case. Headings over a list or a palette are
 *   the shouted kind, LIKE THIS.
 *
 *   A status line is one clause and takes no full stop; prose in a dialog is
 *   as long as the explanation needs and takes one. A failure earns the room
 *   to say why it failed - that is the moment somebody needs the reason.
 *
 *   Never "a, not b". Say what is, and stop.
 *
 *   Chords read `<Key> to <verb>`, and the verb is the technical one: Alt to
 *   exclude, not "alt takes away". Never address the reader as "you".
 *
 *   "Pick" is the eyedropper and nothing else. Choosing from a list or a grid
 *   is "select".
 *
 *   Dimensions are `%d x %d`, with a plain x.
 *
 *   Do not spell out a chord the hint cell already shows: the status bar has
 *   a tool cell and a hint cell beside the message, and a line that repeats
 *   either of them is read twice and believed once.
 *
 * Notes for a translator:
 *
 *   %d, %ls and friends are placeholders the program fills in. Keep them all,
 *   and move them wherever your language needs them — that is why they are
 *   inside the string. %ls is a word or a name; %d is a number.
 *
 *   Strings come in singular and plural pairs where a count decides between
 *   them. Languages needing more than two forms need a rule in Strings.hpp's
 *   Plural(), not more entries here; say so rather than approximating.
 *
 *   Room: a status-bar line has about 120 characters before it is cut, and a
 *   button caption has whatever the dialog template gives it. German runs
 *   about a third longer than English, so the layouts have slack, but not
 *   unlimited slack.
 */

#include "strings.h"

STRINGTABLE
BEGIN
  /* ---------------------------------------------------------- the shell */
  IDS_UNTITLED          "Untitled"
  /* %ls is the file name, then the version. */
  IDS_TITLE             "%ls - PUDForge %ls"
  /* The same, when the map has unsaved changes. */
  IDS_TITLE_DIRTY       "%ls * - PUDForge %ls"
  /* Tile column, tile row, the terrain there. */
  IDS_HOVER_TILE        "%d, %d  %ls"
  IDS_ZOOM_PERCENT      "%d%%"
  IDS_MAP_SIZE          "%d x %d"
  /* Shown greyed when no map has been opened yet. */
  IDS_RECENT_EMPTY      "Recent files"
  /* Position in the list, then the file name. */
  /* What is selected: units and the box round them, or a bare tile box. */
  IDS_SELECTED_ONE      "%d unit, %d x %d"
  IDS_SELECTED_MANY     "%d units, %d x %d"
  IDS_SELECTED_TILES    "%d x %d tiles"
  /* A selection built with shift and alt is not its own box: how many tiles
     are really in it, then how far it reaches. */
  IDS_SELECTED_REGION   "%d tiles in %d x %d"
  IDS_RECENT_ITEM       "%d  %ls"

  /* ---------------------------------------------------------------- file */
  IDS_NEW_MAP           "New map"
  IDS_OPENED            "Opened %ls"
  IDS_SAVED             "Saved %ls"
  /* File name, then why it could not be read. */
  IDS_CANNOT_OPEN       "%ls\n\n%ls"
  IDS_SAVE_CHANGES      "Save the changes to this map?"
  IDS_GENERATED         "Generated"

  /* ----------------------------------------------------------- check map */
  IDS_CHECK_TITLE       "Check Map"
  IDS_CHECK_NONE        "No problems found."
  IDS_SEVERITY_ERROR    "Error: "
  IDS_SEVERITY_WARNING  "Warning: "
  IDS_SEVERITY_NOTE     "Note: "
  /* On opening a map that holds units the game could not put on the board.
     The count, then what to do about it; No is the default. It reuses
     IDS_CHECK_TITLE, because it is the same check said at a different moment. */
  IDS_MISPLACED_ONE     "%d unit in this map is somewhere the game cannot place it.\n\nRemove it?"
  IDS_MISPLACED_MANY    "%d units in this map are somewhere the game cannot place them.\n\nRemove them?"
  IDS_MISPLACED_REMOVED_ONE  "%d misplaced unit removed"
  IDS_MISPLACED_REMOVED_MANY "%d misplaced units removed"
  /* The movement palette's last cell, and what the status bar says when it is
     picked: it takes back whatever the tile drawn there implies. */
  IDS_MOVE_FROM_TERRAIN "Match the terrain"
  /* Movement mode. The layer is not drawn, so the hint says where to look. */
  IDS_TOOL_WALKABLE     "Painting movement"
  IDS_HINT_MOVEMENT     "Drag to paint  Colours are the movement overlay"
  /* The shade row, asked again in movement mode. Two answers, not three: the
     bit is on or it is not. */
  /* The panel's mode switch. The same two words the View menu uses, because
     they are the same two modes. */
  IDS_PANEL_MODE_TERRAIN "Terrain"
  IDS_PANEL_MODE_MOVEMENT "Movement"
  IDS_TIP_PANEL_TERRAIN  "Paint the ground itself: what the map is made of and what it looks like."
  IDS_TIP_PANEL_MOVEMENT "Paint the layer under the artwork: what may walk, swim, sail or fly over each tile, whatever is drawn there."

  /* The bit list under the movement palette. A value is one word and these
     are its bits, so a class in the palette lights some of them and any of
     them can be turned on to reach a value no class has a name for. */
  IDS_ROW_BITS          "Bits"
  IDS_TIP_MOVE_BIT      "%ls (0x%04X). Part of the movement value the brush lays: pick a class above, then turn bits on or off to reach one nothing has a name for."
  /* The name under the palette: the class, or the word itself when no class
     has that value. */
  IDS_MOVE_VALUE        "%ls  0x%04X"
  IDS_MOVE_UNNAMED      "Custom"

  /* ------------------------------------------------------------- editing */
  IDS_STARTS_PLACED_ONE  "%d start location placed"
  IDS_STARTS_PLACED_MANY "%d start locations placed"
  IDS_TILES_FILLED      "%d tiles filled"
  IDS_FILL_NEEDS_RECT   "Select some tiles first, then fill them"
  IDS_UNITS_REMOVED_ONE  "%d unit removed by the terrain change"
  IDS_UNITS_REMOVED_MANY "%d units removed by the terrain change"
  /* Stands in for a player's name when the core has none. */
  IDS_THAT_PLAYER       "that player"
  IDS_OWNS_NOTHING      "%ls owns nothing on this map"
  IDS_OWNED_BY_ONE      "%d unit owned by %ls"
  IDS_OWNED_BY_MANY     "%d units owned by %ls"
  IDS_GIVEN_TO_ONE      "%d unit given to %ls"
  IDS_GIVEN_TO_MANY     "%d units given to %ls"
  IDS_PLACING_FOR       "Placing for %ls"
  /* A fallback name for a player slot, numbered from 1. */
  IDS_PLAYER_N          "Player %d"

  /* ----------------------------------------------------------- clipboard */
  /* A copy takes terrain or units, never both, so each line says only what it
     took. %d is a count of units; the terrain one is a width and a height. */
  IDS_COPIED_ONE        "Copied %d unit. Ctrl+V to paste"
  IDS_COPIED_MANY       "Copied %d units. Ctrl+V to paste"
  IDS_COPIED_TERRAIN    "Copied %d x %d tiles of terrain. Ctrl+V to paste"
  IDS_CUT_ONE           "Cut %d unit. Ctrl+V to paste"
  IDS_CUT_MANY          "Cut %d units. Ctrl+V to paste"
  IDS_NOTHING_COPIED    "Nothing has been copied yet"
  IDS_PASTE_ARMED       "Click to paste. Right-click to cancel"
  IDS_FRAGMENT_SIZE     "Fragment is now %d x %d tiles"

  /* ------------------------------------------------------- terrain panel */
  IDS_ROW_DETAIL        "Detail"
  IDS_DETAIL_PLAIN      "Plain"
  IDS_DETAIL_MIXED      "Mixed"
  IDS_DETAIL_DETAIL     "Detail"
  IDS_ROW_SHAPE         "Shape"
  IDS_ROW_SIZE          "Size"
  IDS_ROW_MIRROR        "Mirror"
  IDS_ROW_SHADE         "Shade"
  IDS_MIX_SHADES_ON     "Strokes will mix the light and dark shade, the way the shipped maps are mottled"
  IDS_MIX_SHADES_OFF    "Strokes lay one flat shade"
  IDS_PICK_A_TILE       "Select a Tile"
  /* %04X is a tile id in hexadecimal; leave it as it is. */
  IDS_CUSTOM_TILE       "Tile 0x%04X"
  /* The two whole-map terrain edits. The ellipsis is part of the label: both
