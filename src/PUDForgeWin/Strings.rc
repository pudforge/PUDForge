  IDS_PLACING_LEFT      "Placing units off"

  /* ------------------------------------------------------------ game data */
  /* Title of the folder picker that asks where the game is installed. */
  IDS_FIND_GAME_TITLE   "Where is Warcraft II installed?"
  /* First run. The heading says why a map editor wants the game at all; the
     note under the list says what the second button does, which is not the same
     thing in the two places this dialog opens from. */
  IDS_SETUP_HEAD_FOUND  "PUDForge draws maps with Warcraft II's own artwork, read from the copy you already own. Choose which one to use."
  IDS_SETUP_HEAD_NONE   "PUDForge draws maps with Warcraft II's own artwork, read from the copy you already own. None was found here — use Browse to point at one."
  IDS_SETUP_NOTE        "Choosing an installation reloads the artwork straight away. Closing this keeps the one already in use."
  IDS_SETUP_NOTE_REQUIRED "PUDForge reads its terrain, units, names and sounds from the game and does not run without it. Closing this window closes PUDForge; you can start it again once the game is installed."
  IDS_SETUP_CANCEL      "Cancel"
  /* The heading and the caption both, in each of the two places this opens
     from — greeting a new install, and answering the Tools menu. */
  IDS_SETUP_TITLE_WELCOME "Welcome to PUDForge"
  IDS_SETUP_TITLE_FIND  "Select Warcraft II Data"
  IDS_SETUP_GUIDE       "User &Guide"
  /* %1 the product, %2 the folder the data was actually found in. */
