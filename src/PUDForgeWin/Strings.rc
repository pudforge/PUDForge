  IDS_BULK_REPLACE      "Replace…"
  IDS_BULK_DECORATE     "Decorate…"
  IDS_TIP_BULK_REPLACE  "Repaint one terrain as another, across the selected tiles or the whole map"
  IDS_TIP_BULK_DECORATE "Scatter a terrain across the selected tiles or the whole map"
  IDS_NO_ARTWORK_TO_PICK "No artwork loaded"

  /* --------------------------------------------------------- units panel */
  /* Grey hint inside the empty search box. */
  IDS_FIND_A_UNIT       "Find a unit"
  /* A row in the quick pick's list, not a heading over a palette, which is
     what it used to be — hence sentence case. */
  IDS_NOTHING_MATCHES   "No unit matches"
  IDS_RACE_HUMAN        "HUMAN"
  IDS_RACE_ORC          "ORC"
  /* The kind carries its own noun, so the heading can be a plain phrase
     rather than two labels joined by punctuation. Buildings and heroes are
     already nouns; land, air and water are not. */
  IDS_KIND_LAND         "LAND UNITS"
  IDS_KIND_AIR          "AIR UNITS"
  IDS_KIND_WATER        "WATER UNITS"
  IDS_KIND_BUILDINGS    "BUILDINGS"
  IDS_KIND_HEROES       "HEROES"
  IDS_GROUP_NEUTRAL     "NEUTRAL"
  IDS_GROUP_MARKERS     "MARKERS"
  /* Race then kind, e.g. "HUMAN LAND UNITS". */
  IDS_GROUP_HEADING     "%ls %ls"

  /* ---------------------------------------------------------- the canvas */
  IDS_PASTED_SHORT      "Pasted the terrain and %d of %d units; %d would not fit"
  IDS_PASTED_ALL        "Pasted the terrain and %d units"
  IDS_PASTED_ONE        "Pasted the terrain and %d unit"
  IDS_PASTED_TERRAIN_ONLY "Pasted the terrain"
  IDS_PASTE_CANCELLED   "Paste cancelled"
  /* Escape or the right button, while a click would have placed a unit. Said
